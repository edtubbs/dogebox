diff --git a/cmd/_dbxroot/cmd/install-to-disk.go b/cmd/_dbxroot/cmd/install-to-disk.go
--- a/cmd/_dbxroot/cmd/install-to-disk.go
+++ b/cmd/_dbxroot/cmd/install-to-disk.go
